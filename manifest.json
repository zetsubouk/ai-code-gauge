{
  "manifest_version": 3,
  "name": "AI 码表 — Coding Plan 用量监控",
  "version": "1.2.0",
  "description": "多供应商 AI Coding Plan 用量监控：智谱 GLM（中国大陆）5小时/每周/MCP、OpenCode Go 5小时/每周/每月。密钥仅存本机，仅发给官方接口。",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://open.bigmodel.cn/*",
    "https://opencode.ai/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Coding Gauge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}